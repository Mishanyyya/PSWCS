#!/usr/bin/env sh

set -eu

USERS_DIR="services/users"

# активируем venv если есть
if [ -f "$USERS_DIR/.venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  . "$USERS_DIR/.venv/bin/activate"
fi

# staged python files
FILES="$(git diff --cached --name-only --diff-filter=ACM | grep '^services/users/.*\.py$' || true)"

if [ -z "$FILES" ]; then
  printf "No python changes\n"
  exit 0
fi

command -v ruff >/dev/null 2>&1 || {
  printf "ERROR: ruff not installed\n"
  exit 1
}

command -v pytest >/dev/null 2>&1 || {
  printf "ERROR: pytest not installed\n"
  exit 1
}

printf "Running ruff...\n"
# shellcheck disable=SC2086
ruff check $FILES

printf "Checking format...\n"
# shellcheck disable=SC2086
ruff format --check $FILES

printf "Running tests...\n"
(
  cd "$USERS_DIR"
  pytest tests/ -q --tb=short
)

printf "OK\n"