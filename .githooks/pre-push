#!/usr/bin/env sh

set -eu

USERS_DIR="services/users"
MIN_COVERAGE=70

if [ -f "$USERS_DIR/.venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  . "$USERS_DIR/.venv/bin/activate"
fi

command -v pytest >/dev/null 2>&1 || {
  printf "ERROR: pytest not installed\n"
  exit 1
}

python -c "import pytest_cov" >/dev/null 2>&1 || {
  printf "ERROR: pytest-cov not installed\n"
  exit 1
}

printf "Running tests with coverage...\n"

(
  cd "$USERS_DIR"
  pytest tests/ \
    --cov=app \
    --cov-report=term-missing \
    --cov-fail-under="$MIN_COVERAGE" \
    -q --tb=short
)

printf "OK coverage >= %s\n" "$MIN_COVERAGE"