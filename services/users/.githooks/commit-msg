#!/usr/bin/env bash
# ─── commit-msg: проверяет формат сообщения коммита ──────────────────────────
# Принудительно использует Conventional Commits:
#   <type>(<scope>): <description>
#
# Примеры допустимых сообщений:
#   feat(users): добавить валидацию email
#   fix(auth): исправить обработку истёкшего токена
#   chore: обновить зависимости

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Игнорируем merge-коммиты и revert
if echo "$COMMIT_MSG" | grep -qE "^(Merge|Revert)"; then
    exit 0
fi

PATTERN="^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\(.+\))?: .{3,}"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
    echo ""
    echo "  ✘  Неправильный формат сообщения коммита!"
    echo ""
    echo "  Используйте Conventional Commits:"
    echo "    <type>(<scope>): <описание>"
    echo ""
    echo "  Типы: feat, fix, docs, style, refactor, perf, test, chore, ci, build"
    echo ""
    echo "  Примеры:"
    echo "    feat(users): добавить эндпоинт регистрации"
    echo "    fix(auth): исправить валидацию токена"
    echo "    test: покрыть тестами user_service"
    echo ""
    echo "  Ваше сообщение: \"$COMMIT_MSG\""
    echo ""
    exit 1
fi

exit 0
