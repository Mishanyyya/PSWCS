#!/usr/bin/env bash
# ─── pre-push: запускается перед git push ─────────────────────────────────────
# Запускает полный прогон тестов с отчётом о покрытии.
# При покрытии < MIN_COVERAGE % — пуш блокируется.

set -euo pipefail

BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
RESET="\033[0m"

log()  { echo -e "${BOLD}[pre-push]${RESET} $*"; }
ok()   { echo -e "${GREEN}✔${RESET}  $*"; }
fail() { echo -e "${RED}✘${RESET}  $*"; exit 1; }

USERS_DIR="services/users"
MIN_COVERAGE=70  # минимальный процент покрытия

log "Полный прогон тестов с coverage (мин. ${MIN_COVERAGE}%)..."

if [ -d "$USERS_DIR/.venv" ]; then
    # shellcheck disable=SC1091
    source "$USERS_DIR/.venv/bin/activate"
fi

# Проверяем наличие pytest-cov
if ! python -m pytest --co -q 2>/dev/null | grep -q "test session"; then
    if ! pip show pytest-cov &>/dev/null; then
        echo -e "${YELLOW}⚠${RESET}  pytest-cov не установлен, запускаем тесты без coverage"
        (cd "$USERS_DIR" && pytest tests/ -q --tb=short) || fail "Тесты упали"
        ok "Тесты прошли (coverage не измерялось)"
        exit 0
    fi
fi

(
    cd "$USERS_DIR"
    pytest tests/ \
        --cov=app \
        --cov-report=term-missing \
        --cov-fail-under="$MIN_COVERAGE" \
        -q --tb=short
) || fail "Тесты упали или покрытие ниже ${MIN_COVERAGE}%. Пуш отменён."

ok "Все тесты прошли, покрытие ≥ ${MIN_COVERAGE}%"
